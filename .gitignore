# ============================================================
# .gitignore — Dynamic Surge Pricing Engine
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
.eggs/

# --- Virtual environments ---
venv/
env/
.venv/
ENV/

# --- DVC ---
# DVC tracks data files; Git should NOT track them directly
/data/raw/
/data/processed/
/models/
# But DO track the .dvc pointer files
!*.dvc
!.dvc/config
!.dvc/.gitignore

# --- MLflow ---
mlruns/
mlartifacts/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Environment variables ---
.env
.env.*
!.env.example

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Reports (auto-generated) ---
reports/*.html

# --- Logs ---
*.log
logs/

# --- Testing artifacts ---
.pytest_cache/
.coverage
htmlcov/
